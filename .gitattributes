# Normalize text files to LF in the repository
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.csv text eol=lf

# Binary assets
*.png binary
*.pdf binary
*.xlsx binary
*.nc binary

# Byte-canonical frozen sigma-sensitivity matrices: the Figure A producer
# regenerates these BYTE-identically (CRLF exactly as originally emitted and
# as pinned by tests/test_figA_sigma_matrices.py). Never EOL-normalize.
scripts/figures/figA1_inputs/*.csv -text
